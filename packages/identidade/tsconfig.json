{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM entra por causa da Web Crypto: o mesmo código roda no navegador e no
    // Node, e é justamente isso que impede as duas pontas de divergirem.
    "lib": ["DOM", "ES2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
