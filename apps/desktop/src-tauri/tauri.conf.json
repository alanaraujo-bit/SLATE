{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLATE",
  "version": "0.1.4",
  "identifier": "com.aionixdev.slate",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4600",
    "beforeDevCommand": "pnpm --filter @slate/desktop dev",
    "beforeBuildCommand": "pnpm --filter @slate/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "SLATE",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "publisher": "Aionixdev",
    "copyright": "© Aionixdev",
    "shortDescription": "Superfície de controle para o seu computador",
    "longDescription": "O SLATE transforma seu celular ou tablet numa superfície de controle inteligente e contextual para este computador.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "minimumWebview2Version": "110.0.1531.0",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "customLanguageFiles": {
          "PortugueseBR": "./windows/PortugueseBR.nsh"
        },
        "headerImage": "./windows/instalador-cabecalho.bmp",
        "sidebarImage": "./windows/instalador-lateral.bmp",
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico",
        "uninstallerHeaderImage": "./windows/instalador-cabecalho.bmp",
        "installerHooks": "./windows/hooks.nsh",
        "startMenuFolder": "Aionixdev",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFMEVFM0E4ODc4QUZCQzIKUldUQys0cUhxT01PanFhU3NjY3hVb2xMUjYvWTV0aEIwMS9uVUxIUTRrWllqR0JYdWUvc0YvNTIK",
      "endpoints": [
        "https://github.com/alanaraujo-bit/SLATE/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
