{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLATE",
  "version": "0.1.0",
  "identifier": "com.aionixdev.slate",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4600",
    "beforeDevCommand": "pnpm --filter @slate/desktop dev",
    "beforeBuildCommand": "pnpm --filter @slate/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "SLATE",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Aionixdev",
    "copyright": "© Aionixdev",
    "shortDescription": "Superfície de controle para o seu computador",
    "longDescription": "O SLATE transforma seu celular ou tablet numa superfície de controle inteligente e contextual para este computador.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
