; Personalização leve sobre o template mantido pelo Tauri. Mantemos o template
; oficial — que recebe correções de instalação e atualização — e trocamos a
; experiência visível do primeiro e do último passo.
!define MUI_WELCOMEPAGE_TITLE "Seu computador, pronto para responder."
!define MUI_WELCOMEPAGE_TEXT "O SLATE conecta este computador ao seu celular ou tablet com segurança.$\r$\n$\r$\nA instalação leva menos de um minuto e não exige acesso de administrador."
!define MUI_FINISHPAGE_TITLE "SLATE instalado."
!define MUI_FINISHPAGE_TEXT "O Agente está pronto. Abra o SLATE e pareie seu celular ou tablet para transformar sua tela em uma superfície de controle."
!define MUI_FINISHPAGE_RUN_TEXT "Abrir o SLATE agora"
!define MUI_UNWELCOMEPAGE_TITLE "Remover o SLATE deste computador?"
!define MUI_UNWELCOMEPAGE_TEXT "O Agente será removido. Seus outros aparelhos e sua conta continuarão intactos."
!define MUI_UNFINISHPAGE_TITLE "SLATE removido."
!define MUI_UNFINISHPAGE_TEXT "O Agente foi removido deste computador."
